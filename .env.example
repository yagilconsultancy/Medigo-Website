# Copy to .env on the production server (the deploy workflow writes this file
# automatically from GitHub secrets).
#
# Every value here is NEXT_PUBLIC_*, so it is baked into the JavaScript bundle
# at build time and is visible to anyone loading the site. Never put a secret
# here. Changing any of these requires a rebuild, not just a restart.

# REQUIRED. getApiClient() throws if this is missing, breaking the contact and
# partner forms. Include the trailing slash, e.g. https://prod-api.getmedigo.com/api/
NEXT_PUBLIC_BASE_API_URL=https://prod-api.getmedigo.com/api

# REQUIRED in practice. Interpolated into the "Book a Ride" / "Schedule Ride"
# links; if unset those hrefs render the literal string "undefined".
# Note the spelling — BOOING, not BOOKING — matches the source.
NEXT_PUBLIC_WEB_BOOING_URL=https://prod-api.getmedigo.com

# Base URL of the Socket.IO endpoint. Falls back to http://localhost:8000,
# which is wrong in production, so set it explicitly.
NEXT_PUBLIC_SOCKET_URL=

# CDN base for image/PDF assets stored by path rather than full URL.
# Optional: only affects the ImagePdfViewer block.
NEXT_PUBLIC_CLOUD_FRONT_URL=

# Tawk.to live chat widget id (the part after https://tawk.to/chat/).
# Optional: leave blank to disable chat.
NEXT_PUBLIC_TAWK_CHAT_ID=
